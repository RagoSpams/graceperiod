# ---- DigitalOcean Gradient AI agent ----
# Leave blank to run in placeholder mode (every endpoint still works for testing).
# Fill both in to switch to the real agent -- no code changes needed.
GRADIENT_ENDPOINT=
GRADIENT_API_KEY=
# Optional: model name if your agent endpoint requires it
GRADIENT_MODEL=
GRADIENT_TIMEOUT=60

# ---- Data files ----
# Point this at the real USCIS H-1B employer disclosure CSV when you have it.
# Defaults to the bundled SAMPLE dataset.
# EMPLOYER_CSV=data/employers_sample.csv
# I539_TEMPLATE=data/forms/i-539.pdf

# ---- Employer risk thresholds (approval rate) ----
EMPLOYER_RISK_LOW=0.90
EMPLOYER_RISK_MED=0.75

# ---- Flask / CORS ----
CORS_ORIGINS=*
MAX_CONTENT_LENGTH=16777216
